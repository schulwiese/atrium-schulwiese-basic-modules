# Line endings are always LF – independent of core.autocrlf and the operating system.
# Migration checksums ignore line endings anyway (core docs/database.md),
# but checkouts and Docker builds should contain the same bytes everywhere.
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert, never diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
*.epbackup binary
